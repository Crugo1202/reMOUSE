<Window x:Class="ReMouse.App.PixelInspectorOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None"
        ResizeMode="NoResize">
    <Canvas x:Name="RootCanvas" IsHitTestVisible="False">
        <Rectangle x:Name="SelectionRectangle"
                   Visibility="Collapsed"
                   Fill="#1410B981"
                   Stroke="#10B981"
                   StrokeThickness="2" />
        <Border x:Name="InfoPanel"
                Background="#E61F2937"
                BorderBrush="#B3D1D5DB"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10">
            <StackPanel>
                <TextBlock x:Name="CursorText"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="SelectionText"
                           Margin="0,6,0,0"
                           Foreground="#D1FAE5"
                           FontSize="12"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,8,0,0"
                           Foreground="#CBD5E1"
                           FontSize="11"
                           Text="Ctrl+C copies coordinates · Shift constrains 45°" />
            </StackPanel>
        </Border>
    </Canvas>
</Window>
