<Window x:Class="ReMouse.App.ApplicationPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose application"
        Width="620"
        Height="440"
        MinWidth="480"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" />
        <ListBox x:Name="ApplicationsList"
                 Grid.Row="1"
                 Margin="0,12,0,12"
                 DisplayMemberPath="DisplayText"
                 MouseDoubleClick="OnApplicationDoubleClick" />
        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="90" Margin="0,0,8,0" Click="OnCancel" Content="Cancel" />
            <Button Width="120" Click="OnUseSelected" Content="Use selected" />
        </StackPanel>
    </Grid>
</Window>
